# Config for the MANET Pi cluster (mesh + k3s) provisioning repo.
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Consumed by:
#   - Makefile (loads this file via `WITH_ENV`, exports to every recipe)
#   - Ansible (playbooks/group_vars/all.yml reads these via `lookup('env', ...)`,
#     falling back to the same defaults shown here if .env isn't sourced -
#     so `ansible-playbook` still works when run directly, not just via `make`)
#   - playbooks/inventories/discover.py and venividivici/controller.py
#     (python-dotenv, loaded automatically from the repo root)
#   - shellscripts/*.sh (read as regular environment variables, with the
#     same defaults baked in as a fallback)
#
# SECURITY NOTE: security has not been prioritized in this repo. The Pi
# credentials below are the Raspberry Pi OS stock default (publicly known),
# not a real secret - every node in this cluster is meant to be reachable
# with it. Nothing else in this repo depends on values here staying private.
# Do not reuse this password scheme for anything internet-facing.

# ---------------------------------------------------------------------------
# Mesh network (B.A.T.M.A.N. / batman-adv)
# ---------------------------------------------------------------------------

# Manager's fixed IP on the bat0 mesh interface. Workers DHCP-lease their own
# bat0 address from the manager instead of having one pinned here.
MESH_MANAGER_IP=192.168.42.1

# DHCP pool the manager's dnsmasq hands out to workers on bat0.
MESH_DHCP_START=192.168.42.2
MESH_DHCP_END=192.168.42.254
MESH_DHCP_LEASE_HOURS=12

# wlan0 ad-hoc mesh radio config - every node must use the same SSID/channel
# to see each other.
MESH_SSID=meshnet
MESH_CHANNEL=1

# Subnet the Pis boot onto over Ethernet, before the mesh exists - what
# discover.py ARP-scans to find them.
WIRED_SCAN_SUBNET=192.168.67.0/24

# Manager's static eth0 IP for a no-router field setup (laptop's ethernet
# plugged directly into the manager - nothing else on that link to hand out
# DHCP). Leave empty for the normal case (router/switch on the wired LAN,
# eth0 stays on dhcp4). Must be inside WIRED_SCAN_SUBNET above. Give your
# laptop's own ethernet NIC a static IP in the same subnet manually (e.g.
# 192.168.67.1) - that part isn't automated, it's your machine, not a Pi.
MANAGER_WIRED_IP=

# DNS suffix for the manager's dnsmasq (e.g. manager0.gotham, dashboard.gotham).
GOTHAM_DOMAIN=gotham

# mDNS name of the manager, from the laptop/controller side (watchctl.sh,
# find_gps_pi.sh's qualify()). Different concept from GOTHAM_DOMAIN's
# manager0.gotham - that resolves via the mesh's own dnsmasq, this resolves
# via mDNS on the wired LAN before/without the mesh.
MANAGER_HOST=manager0.local

# ---------------------------------------------------------------------------
# Pi credentials (see security note above - stock Raspberry Pi OS default)
# ---------------------------------------------------------------------------

PI_SSH_USER=pi
PI_SSH_PASSWORD=raspberry

# ---------------------------------------------------------------------------
# k3s / container registry
# ---------------------------------------------------------------------------

# k3s API server port (standard default, rarely changed).
K3S_API_PORT=6443

# Zot OCI registry (registry/zot.yml). Every image reference in the cluster
# must byte-match REGISTRY_HOST:REGISTRY_PORT - containerd's trust config
# keys off this unnormalized.
REGISTRY_HOST=manager0.gotham
REGISTRY_PORT=30500

# grpcurl release fetched onto each node for the (currently unused) gRPC probe path.
GRPCURL_VERSION=1.9.3

# ---------------------------------------------------------------------------
# Cluster-wide settings
# ---------------------------------------------------------------------------

# Applied to every node so cross-node log timestamps line up.
CLUSTER_TIMEZONE=Europe/Oslo

# Nameserver used where a node needs one outside the mesh's own dnsmasq
# (resolv.conf fallback, bash-prompt "what's my outbound IP" probe).
FALLBACK_DNS=1.1.1.1

# ---------------------------------------------------------------------------
# Field-test logging (fieldlog-resource.service, network_prober.sh)
# ---------------------------------------------------------------------------

# Sample interval in seconds. Kept low-frequency by default since logs land
# on the same SD card as the OS - lower this for short high-resolution runs.
FIELDLOG_INTERVAL=5

# Per-file size cap before single-generation rotation (current -> .old).
FIELDLOG_MAX_SIZE_KB=10240

# false = only log batman-adv's chosen nexthop per destination; true = every
# candidate nexthop too (much higher row count - debugging only).
FIELDLOG_ALL_ROUTES=false

# How far back `make collect-logs` reads the k8-scheduler journal
# (journalctl relative-time syntax).
SCHEDULER_LOG_WINDOW=2 hours ago

# How far back `make collect-logs` pulls radio-wrapper app pod logs
# (kubectl --since duration syntax). Same purpose as SCHEDULER_LOG_WINDOW,
# different tool/format.
APP_LOG_WINDOW=2h

# ---------------------------------------------------------------------------
# Network prober / MQTT
# ---------------------------------------------------------------------------

# gRPC LinkService port-forward target - defined but currently unused
# (network_prober.sh's send_grpc path is commented out in favor of MQTT).
PROBE_GRPC_PORT=30042

# Mosquitto broker each node's network_prober.sh (on-node) publishes link
# data to. 127.0.0.1 works because it's a k3s NodePort, reachable from any
# node (including itself) at that port.
#
# NOT the same as watch_links.sh's own MQTT_HOST/MQTT_PORT env vars - that
# script runs on the laptop/controller (off-mesh), where 127.0.0.1 is wrong;
# it defaults to manager0.local on its own and isn't driven by this file, to
# avoid exactly that collision (see group_vars/all.yml's mqtt_host comment).
PROBE_MQTT_HOST=127.0.0.1
PROBE_MQTT_PORT=31883
MQTT_TOPIC_LINKDATA=network/linkdata

# ---------------------------------------------------------------------------
# venividivici (in-cluster auto-provisioner)
# ---------------------------------------------------------------------------

# How often the controller loop re-scans for never-before-seen Pis, in seconds.
VENIVIDIVICI_POLL_INTERVAL=30

# Per-host SSH reachability probe timeout, in seconds.
VENIVIDIVICI_SSH_PROBE_TIMEOUT=5

# In-cluster MQTT broker address (ClusterIP, not the NodePort MQTT_HOST/
# MQTT_PORT above - venividivici runs inside the cluster and talks to
# mosquitto directly by its Service DNS name).
VENIVIDIVICI_MQTT_BROKER=mosquitto.default.svc.cluster.local
VENIVIDIVICI_MQTT_PORT=1883
VENIVIDIVICI_EVENT_TOPIC=event/node-discovered
