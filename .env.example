# Config for the MANET Pi cluster (mesh + k3s) provisioning repo.
# Copy to .env and adjust: cp .env.example .env
#
# SECURITY NOTE: the Pi credentials below are the public Raspberry Pi OS stock default, not a secret.

# ---------------------------------------------------------------------------
# Mesh network (B.A.T.M.A.N. / batman-adv)
# ---------------------------------------------------------------------------

# Manager's fixed IP on bat0; workers DHCP-lease their own from it.
MESH_MANAGER_IP=192.168.42.1

# DHCP pool the manager's dnsmasq hands out to workers on bat0.
MESH_DHCP_START=192.168.42.2
MESH_DHCP_END=192.168.42.254
MESH_DHCP_LEASE_HOURS=12

# Every node must use the same wlan0 ad-hoc SSID/channel to see each other.
MESH_SSID=meshnet
MESH_CHANNEL=1

# Subnet the Pis boot onto over Ethernet, before the mesh exists.
WIRED_SCAN_SUBNET=192.168.67.0/24

# Manager's static eth0 IP for a no-router field setup. Leave empty for the normal case.
MANAGER_WIRED_IP=

# DNS suffix for the manager's dnsmasq (e.g. manager0.gotham).
GOTHAM_DOMAIN=gotham

# Manager's mDNS name, from the laptop/controller side (before/without the mesh).
MANAGER_HOST=manager0.local

# ---------------------------------------------------------------------------
# Pi credentials (stock Raspberry Pi OS default, see security note above)
# ---------------------------------------------------------------------------

PI_SSH_USER=pi
PI_SSH_PASSWORD=raspberry

# ---------------------------------------------------------------------------
# k3s / container registry
# ---------------------------------------------------------------------------

K3S_API_PORT=6443

# Every image reference in the cluster must byte-match REGISTRY_HOST:REGISTRY_PORT.
REGISTRY_HOST=manager0.gotham
REGISTRY_PORT=30500

# ---------------------------------------------------------------------------
# Cluster-wide settings
# ---------------------------------------------------------------------------

# Applied to every node so cross-node log timestamps line up.
CLUSTER_TIMEZONE=Europe/Oslo

# Nameserver used where a node needs one outside the mesh's own dnsmasq.
FALLBACK_DNS=1.1.1.1

# ---------------------------------------------------------------------------
# Field-test logging (fieldlog-resource.service)
# ---------------------------------------------------------------------------

# Sample interval in seconds; logs land on the same SD card as the OS.
FIELDLOG_INTERVAL=5

# Per-file size cap before single-generation rotation (current -> .old).
FIELDLOG_MAX_SIZE_KB=10240

# true also logs every candidate nexthop, not just the chosen one - debugging only.
FIELDLOG_ALL_ROUTES=false

# How far back `make collect-logs` reads the k8-scheduler journal.
SCHEDULER_LOG_WINDOW=2 hours ago

# How far back `make collect-logs` pulls radio-wrapper app pod logs.
APP_LOG_WINDOW=2h

# ---------------------------------------------------------------------------
# Network prober / MQTT
# ---------------------------------------------------------------------------

# Mosquitto broker the on-node prober publishes link data to (a k3s NodePort).
PROBE_MQTT_HOST=127.0.0.1
PROBE_MQTT_PORT=31883
MQTT_TOPIC_LINKDATA=network/linkdata

# ---------------------------------------------------------------------------
# venividivici (in-cluster auto-provisioner)
# ---------------------------------------------------------------------------

# Seconds between re-scans for never-before-seen Pis.
VENIVIDIVICI_POLL_INTERVAL=30

# Per-host SSH reachability probe timeout, in seconds.
VENIVIDIVICI_SSH_PROBE_TIMEOUT=5

# In-cluster MQTT broker address (ClusterIP, not the NodePort above).
VENIVIDIVICI_MQTT_BROKER=mosquitto.default.svc.cluster.local
VENIVIDIVICI_MQTT_PORT=1883
VENIVIDIVICI_EVENT_TOPIC=event/node-discovered
