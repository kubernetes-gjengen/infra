network:
  version: 2
  renderer: networkd
  ethernets: 
    bat0:
      match:
        name: bat0
{% if 'manager' in group_names %}
      dhcp4: false
      addresses:
        - {{ manager_mesh_ip }}/24
{% else %}
      dhcp4: true
{% endif %}
    eth0:
{% if 'manager' in group_names and manager_wired_ip %}
      dhcp4: false
      addresses:
        - {{ manager_wired_ip }}/24
{% else %}
      dhcp4: true
{% endif %}
